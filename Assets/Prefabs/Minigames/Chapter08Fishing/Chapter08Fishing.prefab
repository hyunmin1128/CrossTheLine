  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBC30\uB97C \uC6C0\uC9C1\uC5EC \uBCF4\uAE00\uAC70\uB9AC\uB294 \uC9C0\uC810\uC744 \uCC3E\uC544\uBCF4\uC138\uC694.\n\nWASD / \uBC29\uD5A5\uD0A4: \uBC30 \uC774\uB3D9     E / Space: \uADF8\uBB3C \uB358\uC9C0\uAE30\n\uC785\uC9C8 \uD45C\uC2DC \u2026 ! \uD6C4 \uB09A\uC2DC \uD654\uBA74\uC774 \uC5F4\uB9BD\uB2C8\uB2E4.\nSpace / \uB9C8\uC6B0\uC2A4 \uC5F0\uD0C0: \uCD08\uB85D \uAD6C\uAC04\uC744 \uC704\uB85C \uC62C\uB9BD\uB2C8\uB2E4.\n\uBB3C\uACE0\uAE30\uB97C \uCD08\uB85D \uAD6C\uAC04 \uC548\uC5D0 \uB450\uACE0 \uC5F0\uD0C0\uD558\uBA74 \uD3EC\uD68D \uAC8C\uC774\uC9C0\uAC00 \uCC39\uB2C8\uB2E4.\n\n\uD55C \uBC88\uC5D0 1~15\uB9C8\uB9AC \xB7 \uBAA9\uD45C 150\uB9C8\uB9AC \xB7 \uD22C\uCC99\uBD80\uD130 \uD3EC\uD68D\uAE4C\uC9C0 \uCD5C\uB300 30\uCD08\n\uBB3C\uACE0\uAE30\uB97C \uB193\uCE58\uBA74 \uC774\uBC88 \uD3EC\uD68D\uB9CC \uC2E4\uD328\uD569\uB2C8\uB2E4.\n\uADF8\uBB3C\uC774 \uCC22\uC5B4\uC9C0\uBA74 6\uCD08 \uD6C4 \uC0C8 \uADF8\uBB3C\uB85C \uAD50\uCCB4\uD569\uB2C8\uB2E4. \uC7A1\uC740 \uC218\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4.\nEsc: \uC77C\uC2DC\uC815\uC9C0"
