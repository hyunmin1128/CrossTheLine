--- !u!114 &4278487356288592734
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2348420230643929612}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC790\uB3D9 \uC804\uC9C4\uD558\uBA70 \uAE30\uB3C4\uB7C9\uC774 \uAE30\uBCF8 \uCD08\uB2F9 1\uC529 \uCDA9\uC804\uB429\uB2C8\uB2E4.\n\uC88C\uC6B0 \uD0A4\uB97C \uB204\uB974\uBA74 \uD55C \uCE78 \uC989\uC2DC \uC774\uB3D9\uD569\uB2C8\uB2E4. \uC704\uC544\uB798 \uC774\uB3D9 \uBD88\uAC00\n\uAE30\uB3C4 \uBC29\uD574 \uC911\uC5D0\uB294 \uCDA9\uC804 \uC815\uC9C0 / \uB0A8\uC740 \uC2DC\uAC04\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n1. \uC218\uD1B5 [E] : \uC815\uD654 + \uC9C0\uCE68 1\uCE78 \uD68C\uBCF5 + \uC7A0\uC2DC \uAC00\uC18D\n2. \uBBFF\uC74C\uC758 \uBC29\uD328 : \uB2E4\uC74C \uCDA9\uB3CC \uC790\uB3D9 \uBC29\uC5B4 \uD6C4 \uC18C\uBAA8\n3. \uC131\uB839\uC758 \uBD88\uAF43 : \uC790\uB3D9 \uAE30\uB3C4 \uAC00\uC18D / 3\uAC1C\uB9C8\uB2E4 \uD53C\uBC84\n4. \uC644\uBCF8 100% / \uD398\uC774\uC9C0 25~40% / \uC870\uAC01 10~25%\n5. \uBB3C \uBCF4\uAE09 : \uC218\uD1B5 \uCDA9\uC804 + \uBCF4\uD638 (\uB9C8\uC9C0\uB9C9 \uAD6C\uAC04 \uC5C6\uC74C)\n\n\uBAA9\uD45C\uB97C \uCC44\uC6B0\uBA74 \uC55E\uC5D0 \uB098\uD0C0\uB098\uB294 \uAE08\uC0C9 \uC120\uC744 \uD1B5\uACFC\uD558\uC138\uC694.\n\uD30C\uB780 \uCE78: \uC5C4\uD3D0 \uBC94\uC704 / \uCD08\uB85D \uCE78: \uD574\uB2F9 \uBC29\uD5A5 \uC5C4\uD3D0 \uC801\uC6A9\n\uC9C0\uCE68 5\uCE78 \xB7 \uD53C\uD574 1\uCE78 \xB7 \uC2E4\uD328 \uC2DC 1\uC77C\uBD80\uD130 \uC7AC\uC2DC\uC791"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
