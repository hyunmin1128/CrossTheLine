  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uCE74\uBA54\uB77C\uB294 \uC55E\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4. WASD/\uBC29\uD5A5\uD0A4\uB85C \uC790\uC720\uB86D\uAC8C \uD53C\uD558\uC138\uC694.\n\uAE30\uB3C4\uB294 \uAE30\uBCF8 \uCD08\uB2F9 1 \uC790\uB3D9 \uCDA9\uC804 / \uBC29\uD574 \uC911 \uC7A0\uC2DC \uC815\uC9C0\n\n1. \uC218\uD1B5 [E] : \uC815\uD654 + \uCCB4\uB825 1 \uD68C\uBCF5 + \uC7A0\uC2DC \uAC00\uC18D\n2. \uBBFF\uC74C\uC758 \uBC29\uD328 : \uB2E4\uC74C \uCDA9\uB3CC \uC790\uB3D9 \uBC29\uC5B4 \uD6C4 \uC18C\uBAA8\n3. \uC131\uB839\uBD88 3\uAC1C : \uD53C\uBC84 5\uCD08 / \uCD08\uC0C1\uD654\uC758 \uBD88\uAF43\uACFC \uAC8C\uC774\uC9C0\uB85C \uD655\uC778\n4. \uC644\uBCF8 100% / \uD398\uC774\uC9C0 25~40% / \uC870\uAC01 10~25%\n5. \uBB3C \uBCF4\uAE09 : \uC218\uD1B5 \uCDA9\uC804 + \uBCF4\uD638 (\uB9C8\uC9C0\uB9C9 \uAD6C\uAC04 \uC5C6\uC74C)\n\n\uD53C\uBC84 \uC911 \uAC8C\uC774\uC9C0\uAC00 \uC904\uC5B4\uB4E4\uBA70 0\uC774 \uB418\uBA74 \uC885\uB8CC\uB429\uB2C8\uB2E4.\n\uC7A5\uC560\uBB3C\uC740 \uC704\uC5D0\uC11C \uB4F1\uC7A5\uD569\uB2C8\uB2E4. \uBAA8\uB798\uBC14\uB78C 1~2\uAE38 / \uB3CC\uBA69\uC774 1\uAE38"
