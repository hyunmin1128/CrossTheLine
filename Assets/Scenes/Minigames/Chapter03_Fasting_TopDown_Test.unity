    - target: {fileID: 4278487356288592734, guid: 171a63b0fc82f9d4db354e81291ee278, type: 3}
      propertyPath: m_text
      value: "WASD / \uBC29\uD5A5\uD0A4: \uC774\uB3D9\nSpace \uC720\uC9C0: 0.3\uCD08 \uC900\uBE44 \uD6C4 \uAE30\uB3C4 \xB7 \uC774\uB3D9\uC18D\uB3C4 15%\n\uACF5\uACA9\uC774 \uC9C0\uB098\uAC04 \uB4A4 \uCCAD\uB85D\uC0C9 \uD45C\uC2DC\uAC00 \uCF1C\uC9C0\uBA74 \uAE30\uB3C4\uD560 \uD2C8\uC785\uB2C8\uB2E4.\nE: \uC218\uD1B5 \uC0AC\uC6A9 \xB7 R: \uCC98\uC74C\uBD80\uD130\n\n\uC131\uACBD \uC644\uBCF8: \uC774 \uAD6C\uAC04 \uAE30\uB3C4 \uC644\uB8CC\n\uD398\uC774\uC9C0 / \uC870\uAC01: \uAE30\uB3C4 \uAC8C\uC774\uC9C0 \uC77C\uBD80 \uCDA9\uC804\n\uC131\uB839\uBD88: \uAE30\uB3C4 \uAC00\uC18D \xB7 3\uAC1C\uB85C \uD53C\uBC84 (\uAE30\uB3C4\uD560 \uB54C\uB9CC \uC2DC\uAC04 \uC18C\uBAA8)\n\uBC29\uD328: \uB2E4\uC74C \uD53C\uACA9 \uC790\uB3D9 \uBC29\uC5B4\n\uC6B0\uBB3C: \uBE48 \uC218\uD1B5\uC744 \uD55C \uBC88 \uCDA9\uC804 \xB7 \uC704\uCE58/\uB4F1\uC7A5\uC740 \uBB34\uC791\uC704\n\uC2E4\uD328\uD558\uBA74 \uB2E4\uC2DC \uC2DC\uC791 \uBC84\uD2BC\uC73C\uB85C \uC7AC\uB3C4\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
